# PlayBeatTV — environment variables (copy to .env to enable locally)

# Optional: enables the AI assistant chat feature. If unset, /api/status
# reports "gemini: not configured" and the UI hides the input.
GEMINI_API_KEY=

# Port for the Express dev server (`npm run dev`).
# PORT=3001

# Used by `npm run preview` after `npm run build`.
# NODE_ENV=production
